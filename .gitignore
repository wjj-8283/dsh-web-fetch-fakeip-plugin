# 依赖
node_modules/
.pnpm-store/
.pnpm/

# npm 的锁文件：devDependencies 只用于测试，不锁定（与作者其它插件仓库一致）
package-lock.json

# 构建中间产物 / 缓存。注意 lib/client.js 是 build.mjs 的产物但要提交：
# 浏览器半插件由 shell 直接按 exports["./client"] 取文件，npm 包也必须带预构建产物。
dist/
build/
coverage/
*.tsbuildinfo

# 打包产物（仓库里只放源码，归档由使用者自行生成）
*.tgz
*.tar.gz

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# 本地测试符号链接（开发时把 node_modules 指到 profile 的拦截层用）
/test/node_modules
